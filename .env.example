APP_ENV=development
ENCRYPTION_KEY=
DB_PATH=sqlite:///./display_manager.db
HOST=0.0.0.0
PORT=8000
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-session-secret
# Comma-separated list of allowed Host header values.
# IMPORTANT: add your server's public hostname/domain here, otherwise remote
# display clients (Raspberry Pi etc.) will receive a 403 Forbidden response.
# Example: TRUSTED_HOSTS=localhost,127.0.0.1,test.angry.fish
# Use * to allow all hosts (only safe behind a trusted reverse proxy):
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1